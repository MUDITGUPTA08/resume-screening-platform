# GROQ_API_KEY: Required for Groq LLM API calls (used for resume screening).
# Get a free-tier key at https://console.groq.com/keys
GROQ_API_KEY="MY_GROQ_API_KEY"

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: Required for persisting jobs and
# applications. Service role key only — this app never uses the anon key,
# since all database access happens server-side.
# Project Settings > API in your Supabase dashboard.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# ADMIN_PASSCODE: Shared passcode gating the /api/admin/* routes and the
# admin UI tab. Optional — defaults to "admin123" if unset.
ADMIN_PASSCODE="admin123"
